{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "All app windows may use core APIs (events, window info).",
  "windows": ["strip", "flyout", "settings", "overlay-*"],
  "permissions": [
    "core:default",
    "updater:default",
    "dialog:default",
    "process:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging"
  ]
}
